# --- Banco ---
DATABASE_URL=postgresql://rosa:rosa@localhost:5432/rosa_dev

# --- Site ---
# URL pública (sitemap, Open Graph, links canônicos)
SITE_URL=http://localhost:3000
# "1" quando roda atrás de um proxy reverso confiável que acrescenta X-Forwarded-For
TRUST_PROXY=0

# --- Storage S3-compatível (Cloudflare R2, AWS S3, MinIO) ---
S3_ENDPOINT=
S3_REGION=auto
S3_BUCKET=
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=
# URL pública do bucket (ex.: https://fotos.rosadodeserto.com.br)
S3_PUBLIC_BASE_URL=

# --- E-mail (códigos de recuperação de senha) ---
# ex.: smtps://usuario:senha@smtp.provedor.com:465
SMTP_URL=
MAIL_FROM="Rosa do Deserto <nao-responda@rosadodeserto.com.br>"
